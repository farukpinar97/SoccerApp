@model ResultMatchDto
@{
    ViewData["Title"] = $"{Model.HomeTeam?.Name} - {Model.AwayTeam?.Name}";
    ViewBag.ActivePage = "home";

    var events = ViewBag.Events as List<ResultMatchEventDto> ?? new List<ResultMatchEventDto>();
    var stat = ViewBag.Statistic as ResultMatchStatisticDto;

    // Olayları türe göre ayır
    var goals = events.Where(x => x.EventType?.Code == "goal").OrderBy(x => x.Minute).ToList();
    var yellows = events.Where(x => x.EventType?.Code == "yellow").OrderBy(x => x.Minute).ToList();
    var reds = events.Where(x => x.EventType?.Code == "red").OrderBy(x => x.Minute).ToList();
    var subs = events.Where(x => x.EventType?.Code == "sub").OrderBy(x => x.Minute).ToList();

    var homeId = Model.HomeTeamId;

    // İkinci yarı skoru = maç sonu - ilk yarı
    var secondHalfHome = (Model.FullTimeHomeScore ?? 0) - (Model.HalfTimeHomeScore ?? 0);
    var secondHalfAway = (Model.FullTimeAwayScore ?? 0) - (Model.HalfTimeAwayScore ?? 0);

    var statusText = Model.Status switch
    {
        MatchStatus.Completed => "Maç Sona Erdi",
        MatchStatus.InProgress => "Devam Ediyor",
        _ => "Henüz Oynanmadı"
    };

    // Olay türüne göre chip / ikon sınıfı
    Func<string, string> chipClass = code => code switch
    {
        "goal" => "goal-ev",
        "yellow" => "yel-ev",
        "red" => "red-ev",
        _ => "sub-ev"
    };

    Func<string, string> icoClass = code => code switch
    {
        "goal" => "ei-goal",
        "yellow" => "ei-yel",
        "red" => "ei-red",
        _ => "ei-sub"
    };
}

<!-- HERO -->
<section class="hero">
    <div class="wrap">
        <div class="hero-badges">
            <span class="hbadge hb-gold">
                <i class="bi bi-trophy-fill me-1"></i>Premier League · Hafta @Model.Week?.WeekNumber
            </span>
            <span class="hbadge hb-gray">
                <i class="bi bi-check2-circle me-1"></i>@statusText
            </span>
            @if (Model.Attendance.HasValue)
            {
                <span class="hbadge hb-green">
                    <i class="bi bi-people-fill me-1"></i>@Model.Attendance.Value.ToString("N0") Seyirci
                </span>
            }
        </div>

        <div class="hero-grid">
            <div class="h-team">
                <div class="h-logo">
                    <img src="@Model.HomeTeam?.LogoUrl" alt="@Model.HomeTeam?.ShortName"
                         onerror="this.parentNode.textContent='@Model.HomeTeam?.ShortName'" />
                </div>
                <div class="h-name">@Model.HomeTeam?.Name</div>
                <div class="h-type">Ev Sahibi</div>
            </div>

            <div class="h-score-c">
                <div class="h-sc">@Model.ScoreText</div>
                <div class="h-ht"><i class="bi bi-hourglass-split me-1"></i>İY: @Model.HalfTimeText</div>
                <div class="h-ft">@statusText</div>
            </div>

            <div class="h-team">
                <div class="h-logo">
                    <img src="@Model.AwayTeam?.LogoUrl" alt="@Model.AwayTeam?.ShortName"
                         onerror="this.parentNode.textContent='@Model.AwayTeam?.ShortName'" />
                </div>
                <div class="h-name">@Model.AwayTeam?.Name</div>
                <div class="h-type">Deplasman</div>
            </div>
        </div>

        <div class="info-strip">
            <div class="istrip">
                <i class="bi bi-geo-alt-fill"></i>
                <span>@Model.Stadium?.Name@(string.IsNullOrEmpty(Model.Stadium?.City) ? "" : ", " + Model.Stadium.City)</span>
            </div>
            <div class="istrip">
                <i class="bi bi-calendar3"></i><span>@Model.MatchDateTime.ToString("d MMMM yyyy")</span>
            </div>
            <div class="istrip">
                <i class="bi bi-clock"></i><span>@Model.MatchDateTime.ToString("HH:mm")</span>
            </div>
            @if (Model.Referee != null)
            {
                <div class="istrip">
                    <i class="bi bi-person-badge"></i><span>@Model.Referee.FullName</span>
                </div>
            }
        </div>
    </div>
</section>

<div class="content">
    <div class="wrap">
        <a asp-controller="Default" asp-action="Index" class="back-btn">
            <i class="bi bi-arrow-left"></i> Maç Listesine Dön
        </a>

        <div class="row g-4">

            <!-- SOL: OLAYLAR -->
            <div class="col-lg-7">

                <!-- ZAMAN ÇİZELGESİ -->
                <div class="dc">
                    <div class="dc-title">
                        <i class="bi bi-activity me-2" style="color:var(--green)"></i>Maç Olayları
                    </div>

                    @if (!events.Any())
                    {
                        <div style="color:var(--t2);font-size:13px;padding:8px 0">
                            Bu maç için olay girilmemiş.
                        </div>
                    }
                    else
                    {
                        <div class="tl-wrap">
                            <div class="tl-line"></div>

                            @foreach (var ev in events.OrderBy(x => x.Minute))
                            {
                                var isHomeEvent = ev.TeamId == homeId;
                                var code = ev.EventType?.Code ?? "goal";

                                <div class="tl-ev">
                                    <div class="tl-home">
                                        @if (isHomeEvent)
                                        {
                                            <div class="chip home @chipClass(code)">
                                                <div class="ev-ico @icoClass(code)">
                                                    @if (code == "goal")
                                                    {
                                                        <i class="bi bi-circle-fill" style="font-size:9px"></i>
                                                    }
                                                    else if (code == "sub")
                                                    {
                                                        <i class="bi bi-arrow-left-right"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-square-fill" style="font-size:10px"></i>
                                                    }
                                            </div>
                                            <div>
                                                <div class="ev-pl">
                                                    @ev.Player?.FullName@(code == "sub" ? " ↓" : "")
                                                </div>
                                                <div class="ev-dt">
                                                    @(code == "sub" && ev.PlayerIn != null
                                                                                                ? ev.PlayerIn.FullName + " ↑"
                                                                                                : ev.Description)
                                        </div>
                                    </div>
                                </div>
                                                                }
                                    </div>

                                    <div class="tl-min-c"><div class="min-b">@ev.Minute'</div></div>

                                    <div class="tl-away">
                                        @if (!isHomeEvent)
                                        {
                                            <div class="chip away @chipClass(code)">
                                                <div class="ev-ico @icoClass(code)">
                                                    @if (code == "goal")
                                                    {
                                                        <i class="bi bi-circle-fill" style="font-size:9px"></i>
                                                    }
                                                    else if (code == "sub")
                                                    {
                                                        <i class="bi bi-arrow-left-right"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-square-fill" style="font-size:10px"></i>
                                                    }
                                            </div>
                                            <div>
                                                <div class="ev-pl">
                                                    @ev.Player?.FullName@(code == "sub" ? " ↓" : "")
                                                </div>
                                                <div class="ev-dt">
                                                    @(code == "sub" && ev.PlayerIn != null
                                                                                                ? ev.PlayerIn.FullName + " ↑"
                                                                                                : ev.Description)
                                        </div>
                                    </div>
                                </div>
                                                                }
                                    </div>
                                </div>
                            }

                            <!-- MAÇ SONU -->
                            <div class="tl-ev">
                                <div class="tl-home"></div>
                                <div class="tl-min-c">
                                    <div class="min-b"
                                         style="background:rgba(143,163,200,.08);border-color:rgba(143,163,200,.18);color:var(--t2)">
                                        MS
                                    </div>
                                </div>
                                <div class="tl-away"></div>
                            </div>
                        </div>
                    }
                </div>

                <!-- GOLLER -->
                @if (goals.Any())
                {
                    <div class="dc">
                        <div class="dc-title">
                            <i class="bi bi-circle-fill me-2" style="color:var(--green);font-size:9px"></i>Goller
                        </div>
                        <div class="split2">
                            <div class="box2">
                                <div class="box2-title">⚽ @Model.HomeTeam?.Name</div>
                                @foreach (var g in goals.Where(x => x.TeamId == homeId))
                                {
                                    <div class="gl">
                                        <div class="gl-ico">⚽</div>
                                        <div class="gl-pl">@g.Player?.FullName</div>
                                        <div class="gl-min">@g.Minute'</div>
                                    </div>
                                }
                            </div>
                            <div class="box2">
                                <div class="box2-title">⚽ @Model.AwayTeam?.Name</div>
                                @foreach (var g in goals.Where(x => x.TeamId != homeId))
                                {
                                    <div class="gl">
                                        <div class="gl-ico">⚽</div>
                                        <div class="gl-pl">@g.Player?.FullName</div>
                                        <div class="gl-min">@g.Minute'</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- KARTLAR -->
                @if (yellows.Any() || reds.Any())
                {
                    <div class="dc">
                        <div class="dc-title">
                            <i class="bi bi-square-fill me-2" style="color:var(--yellow);font-size:10px"></i>Kartlar
                        </div>
                        <div class="split2">
                            <div class="box2">
                                <div class="box2-title">@Model.HomeTeam?.Name</div>
                                @foreach (var c in yellows.Where(x => x.TeamId == homeId))
                                {
                                    <div class="gl">
                                        <div class="ycard"></div>
                                        <div class="gl-pl">@c.Player?.FullName</div>
                                        <div class="gl-min">@c.Minute'</div>
                                    </div>
                                }
                                @foreach (var c in reds.Where(x => x.TeamId == homeId))
                                {
                                    <div class="gl">
                                        <div class="rcard"></div>
                                        <div class="gl-pl">@c.Player?.FullName</div>
                                        <div class="gl-min">@c.Minute'</div>
                                    </div>
                                }
                            </div>
                            <div class="box2">
                                <div class="box2-title">@Model.AwayTeam?.Name</div>
                                @foreach (var c in yellows.Where(x => x.TeamId != homeId))
                                {
                                    <div class="gl">
                                        <div class="ycard"></div>
                                        <div class="gl-pl">@c.Player?.FullName</div>
                                        <div class="gl-min">@c.Minute'</div>
                                    </div>
                                }
                                @foreach (var c in reds.Where(x => x.TeamId != homeId))
                                {
                                    <div class="gl">
                                        <div class="rcard"></div>
                                        <div class="gl-pl">@c.Player?.FullName</div>
                                        <div class="gl-min">@c.Minute'</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- OYUNCU DEĞİŞİKLİKLERİ -->
                @if (subs.Any())
                {
                    <div class="dc">
                        <div class="dc-title">
                            <i class="bi bi-arrow-left-right me-2" style="color:var(--blue)"></i>Oyuncu Değişiklikleri
                        </div>

                        <div class="sub-lbl">@Model.HomeTeam?.Name</div>
                        @foreach (var s in subs.Where(x => x.TeamId == homeId))
                        {
                            <div class="sub-r">
                                <div class="sub-min">@s.Minute'</div>
                                <div class="sub-in">↑ @s.PlayerIn?.FullName</div>
                                <div class="sub-arr">⇄</div>
                                <div class="sub-out">↓ @s.Player?.FullName</div>
                            </div>
                        }

                        <div class="sub-lbl">@Model.AwayTeam?.Name</div>
                        @foreach (var s in subs.Where(x => x.TeamId != homeId))
                        {
                            <div class="sub-r">
                                <div class="sub-min">@s.Minute'</div>
                                <div class="sub-in">↑ @s.PlayerIn?.FullName</div>
                                <div class="sub-arr">⇄</div>
                                <div class="sub-out">↓ @s.Player?.FullName</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- SAĞ: ÖZET, İSTATİSTİK, BİLGİ -->
            <div class="col-lg-5">

                <!-- MAÇ ÖZETİ -->
                <div class="dc">
                    <div class="dc-title">
                        <i class="bi bi-bar-chart-fill me-2" style="color:var(--blue)"></i>Maç Özeti
                    </div>
                    <div class="sc-pills">
                        <div class="sc-pill">
                            <div class="sp-lbl">İlk Yarı</div>
                            <div class="sp-val">@Model.HalfTimeText</div>
                        </div>
                        <div class="sc-pill">
                            <div class="sp-lbl">İkinci Yarı</div>
                            <div class="sp-val">@secondHalfHome – @secondHalfAway</div>
                        </div>
                        <div class="sc-pill">
                            <div class="sp-lbl">Sonuç</div>
                            <div class="sp-val" style="color:var(--green)">@Model.ScoreText</div>
                        </div>
                    </div>
                </div>

                <!-- İSTATİSTİKLER -->
                <div class="dc">
                    <div class="dc-title">
                        <i class="bi bi-graph-up me-2" style="color:var(--green)"></i>İstatistikler
                    </div>

                    @if (stat == null)
                    {
                        <div style="color:var(--t2);font-size:13px">
                            Bu maç için istatistik girilmemiş.
                        </div>
                    }
                    else
                    {
                        // (etiket, ev değeri, deplasman değeri, gösterim son eki)
                        var rows = new (string Label, int Home, int Away, string Suffix)[]
                        {
                                        ("Topa Sahip Olma", stat.HomePossession, stat.AwayPossession, "%"),
                                        ("Şut", stat.HomeShots, stat.AwayShots, ""),
                                        ("İsabetli Şut", stat.HomeShotsOnTarget, stat.AwayShotsOnTarget, ""),
                                        ("Pas", stat.HomePasses, stat.AwayPasses, ""),
                                        ("Pas İsabeti", stat.HomePassAccuracy, stat.AwayPassAccuracy, "%"),
                                        ("Korner", stat.HomeCorners, stat.AwayCorners, ""),
                                        ("Faul", stat.HomeFouls, stat.AwayFouls, ""),
                                        ("Ofsayt", stat.HomeOffsides, stat.AwayOffsides, "")
                        };

                        foreach (var row in rows)
                        {
                            var homePercent = ResultMatchStatisticDto.BarPercent(row.Home, row.Away);

                            <div class="stat-r">
                                <div class="sv-h">@row.Home@row.Suffix</div>
                                <div class="sl">@row.Label</div>
                                <div class="sv-a">@row.Away@row.Suffix</div>
                            </div>
                            <div class="bar-r">
                                <div class="bh"><div class="f" style="width:@(homePercent)%"></div></div>
                                <div></div>
                                <div class="ba"><div class="f" style="width:@(100 - homePercent)%"></div></div>
                            </div>
                        }

                        <div class="stat-r" style="margin-bottom:0;margin-top:14px">
                            <div class="sv-h" style="color:var(--yellow)">@stat.HomeYellowCards</div>
                            <div class="sl">Sarı Kart</div>
                            <div class="sv-a" style="color:var(--yellow)">@stat.AwayYellowCards</div>
                        </div>
                        <div class="stat-r" style="margin-bottom:0;margin-top:8px">
                            <div class="sv-h" style="color:var(--red)">@stat.HomeRedCards</div>
                            <div class="sl">Kırmızı Kart</div>
                            <div class="sv-a" style="color:var(--red)">@stat.AwayRedCards</div>
                        </div>

                        <div style="display:flex;justify-content:space-between;margin-top:18px;
                                        padding-top:14px;border-top:1px solid var(--border)">
                            <div style="display:flex;align-items:center;gap:7px">
                                <div style="width:9px;height:9px;border-radius:50%;background:var(--blue)"></div>
                                <span style="font-family:var(--fd);font-size:12px;font-weight:700;color:var(--t2)">
                                    @Model.HomeTeam?.Name
                                </span>
                            </div>
                            <div style="display:flex;align-items:center;gap:7px">
                                <span style="font-family:var(--fd);font-size:12px;font-weight:700;color:var(--t2)">
                                    @Model.AwayTeam?.Name
                                </span>
                                <div style="width:9px;height:9px;border-radius:50%;background:var(--live)"></div>
                            </div>
                        </div>
                    }
                </div>

                <!-- MAÇ BİLGİLERİ -->
                <div class="dc">
                    <div class="dc-title">
                        <i class="bi bi-info-circle me-2" style="color:var(--t3)"></i>Maç Bilgileri
                    </div>
                    <div class="mi-row">
                        <span class="mi-key">Lig</span>
                        <span class="mi-val" style="color:var(--gold)">Premier League</span>
                    </div>
                    <div class="mi-row">
                        <span class="mi-key">Sezon</span><span class="mi-val">2024 / 2025</span>
                    </div>
                    <div class="mi-row">
                        <span class="mi-key">Hafta</span><span class="mi-val">Hafta @Model.Week?.WeekNumber</span>
                    </div>
                    <div class="mi-row">
                        <span class="mi-key">Stadyum</span><span class="mi-val">@Model.Stadium?.Name</span>
                    </div>
                    <div class="mi-row">
                        <span class="mi-key">Şehir</span><span class="mi-val">@Model.Stadium?.City</span>
                    </div>
                    @if (Model.Attendance.HasValue)
                    {
                        <div class="mi-row">
                            <span class="mi-key">Seyirci</span>
                            <span class="mi-val">@Model.Attendance.Value.ToString("N0")</span>
                        </div>
                    }
                    @if (Model.Referee != null)
                    {
                        <div class="mi-row">
                            <span class="mi-key">Hakem</span><span class="mi-val">@Model.Referee.FullName</span>
                        </div>
                    }
                    <div class="mi-row">
                        <span class="mi-key">Tarih</span>
                        <span class="mi-val">@Model.MatchDateTime.ToString("d MMMM yyyy")</span>
                    </div>
                    <div class="mi-row">
                        <span class="mi-key">Saat</span>
                        <span class="mi-val">@Model.MatchDateTime.ToString("HH:mm")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-2">
            <a asp-controller="Default" asp-action="Index" class="back-btn">
                <i class="bi bi-arrow-left"></i> Tüm Maçlara Dön
            </a>
        </div>
    </div>
</div>
