@{
    // Aktif menü öğesini belirlemek için — her view kendi ViewBag.ActivePage değerini set eder
    var active = ViewBag.ActivePage as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GoalZone</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- NAVBAR -->
    <nav class="nb">
        <div class="nb-inner">
            <a asp-controller="Default" asp-action="Index" class="brand">
                <div class="brand-ico">⚽</div>
                <span class="brand-txt">Goal<span>Zone</span></span>
            </a>

            <div class="nav-links d-none d-lg-flex">
                <a asp-controller="Default" asp-action="Index"
                   class="nl @(active == "home" ? "active" : "")">Ana Sayfa</a>
                <a asp-controller="Fixtures" asp-action="Index"
                   class="nl @(active == "fixtures" ? "active" : "")">Fikstür</a>
                <a asp-controller="Standings" asp-action="Index"
                   class="nl @(active == "standings" ? "active" : "")">Puan Durumu</a>
                <a asp-controller="Admin" asp-action="Index"
                   class="nl @(active == "admin" ? "active" : "")">Admin</a>
            </div>

            <div class="nb-icons">
                <a href="#" class="ico-btn d-none d-sm-flex"><i class="bi bi-search"></i></a>
                <a href="#" class="ico-btn d-none d-sm-flex"><i class="bi bi-bell"></i></a>
                <a href="#" class="ico-btn"><i class="bi bi-person"></i></a>
                <button class="tog d-lg-none" id="tog"><i class="bi bi-list"></i></button>
            </div>
        </div>

        <div class="mob-menu" id="mobMenu">
            <div class="wrap">
                <a asp-controller="Default" asp-action="Index"
                   class="nl d-block @(active == "home" ? "active" : "")">Ana Sayfa</a>
                <a asp-controller="Fixtures" asp-action="Index"
                   class="nl d-block @(active == "fixtures" ? "active" : "")">Fikstür</a>
                <a asp-controller="Standings" asp-action="Index"
                   class="nl d-block @(active == "standings" ? "active" : "")">Puan Durumu</a>
                <a asp-controller="Admin" asp-action="Index"
                   class="nl d-block @(active == "admin" ? "active" : "")">Admin</a>
            </div>
        </div>
    </nav>

    @RenderBody()

    <!-- FOOTER -->
    <footer class="ft">
        <div class="wrap">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="ft-brand">Goal<span>Zone</span></div>
                    <p class="ft-desc">
                        Premier futbol liglerinin canlı skorları, maç analizleri ve
                        istatistikleri için tek adres.
                    </p>
                    <div class="si-row">
                        <a href="#" class="si"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="si"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="si"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="si"><i class="bi bi-telegram"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <div class="ft-h">Ligler</div>
                    <ul class="ft-ul">
                        <li><a href="#">Premier League</a></li>
                        <li><a href="#">La Liga</a></li>
                        <li><a href="#">Bundesliga</a></li>
                        <li><a href="#">Serie A</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <div class="ft-h">Hızlı Erişim</div>
                    <ul class="ft-ul">
                        <li><a asp-controller="Default" asp-action="Index">Haftalık Skorlar</a></li>
                        <li><a asp-controller="Fixtures" asp-action="Index">Fikstür</a></li>
                        <li><a asp-controller="Standings" asp-action="Index">Puan Durumu</a></li>
                        <li><a asp-controller="Admin" asp-action="Index">Admin Panel</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <div class="ft-h">Takımlar</div>
                    <ul class="ft-ul">
                        <li><a href="#">Arsenal</a></li>
                        <li><a href="#">Liverpool</a></li>
                        <li><a href="#">Man City</a></li>
                        <li><a href="#">Chelsea</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <div class="ft-h">Destek</div>
                    <ul class="ft-ul">
                        <li><a href="#">Hakkımızda</a></li>
                        <li><a href="#">İletişim</a></li>
                        <li><a href="#">Gizlilik</a></li>
                        <li><a href="#">Kullanım Şartları</a></li>
                    </ul>
                </div>
            </div>

            <div class="ft-bot">
                <span>© @DateTime.Now.Year GoalZone. Tüm hakları saklıdır.</span>
                <span>Premier League verileri demo amaçlıdır.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Mobil menü
        const tog = document.getElementById('tog');
        const mob = document.getElementById('mobMenu');
        tog.addEventListener('click', () => {
            mob.classList.toggle('open');
            tog.innerHTML = mob.classList.contains('open')
                ? '<i class="bi bi-x-lg"></i>' : '<i class="bi bi-list"></i>';
        });

        // Scroll'da navbar gölgesi
        window.addEventListener('scroll', () => {
            document.querySelector('.nb').style.boxShadow =
                window.scrollY > 8 ? '0 4px 32px rgba(0,0,0,.7)' : '0 2px 24px rgba(0,0,0,.5)';
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
